# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Next.js Boilerplate"
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# MongoDB Atlas
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────
# NextAuth.js
# ─────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars   # openssl rand -base64 32

# ─────────────────────────────────────────────────────────────
# OAuth Providers (optional)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─────────────────────────────────────────────────────────────
# JWT (for custom tokens if needed alongside NextAuth)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Email (Resend / Nodemailer)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ─────────────────────────────────────────────────────────────
# File Storage (Cloudinary / AWS S3)
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─────────────────────────────────────────────────────────────
# Analytics / Monitoring
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0
